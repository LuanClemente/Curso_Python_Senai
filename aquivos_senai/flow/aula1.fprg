    <function name="parte2" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero" type="Integer" array="False" size=""/>
            <while expression="true">
                <output expression="&quot;Digite um Numero:&quot;" newline="True"/>
                <input variable="numero"/>
                <output expression="&quot;Voc&#234; digitou o n&#250;mero:&quot;&amp;numero" newline="True"/>
            </while>
        </body>
