    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numero" type="Real" array="False" size=""/>
            <output expression="&quot;Quer ver um truque m&#225;gico? Digite um n&#250;mero:&quot;" newline="True"/>
            <input variable="numero"/>
            <comment text="MAGIA acontecendo"/>
            <output expression="&quot;Alacazin!!! Voc&#234; digitou o seguinte n&#250;mero:&quot;&amp;numero" newline="True"/>
